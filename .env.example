# คัดลอกเป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ห้าม commit)
ENV=dev
DATABASE_URL=
REDIS_URL=
LOGA_BASE_URL=https://loga.app
LOGA_USER=              # อีเมลที่ใช้สมัคร Loga Merchant
LOGA_PASSWORD=          # รหัสผ่านตัวจริง (ห้ามใส่ MD5 — ระบบแฮชให้เองตอนยิง)
LOGA_CARD_ID=           # เลขที่บัตร ดูจากเว็บ Loga Merchant แถบ Manage > Card Info
LOGA_DEVICE_ID=         # loga เรียก uuid — string อะไรก็ได้ แต่ "ตั้งแล้วห้ามเปลี่ยน"
                        # เช่น getpoint-prod-01 (เปลี่ยนเมื่อไหร่ token เดิมใช้ไม่ได้)
LOGA_TIMEOUT_SECONDS=10
LINE_CHANNEL_TOKEN=
SMS_API_KEY=
GEMINI_API_KEY=
